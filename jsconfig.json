{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/context/*": ["./src/context/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/services/*": ["./src/services/*"],
      "@/animations/*": ["./src/animations/*"],
      "@/server/*": ["./src/server/*"],
      "@/models/*": ["./src/models/*"],
      "@/backend/*": ["./src/backend/*", "./src/lib/*"],
      "@/database/*": ["./src/database/*", "./src/data/*"],
      "@/frontend/*": ["./src/frontend/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.js", "**/*.jsx"],
  "exclude": ["node_modules"]
}
