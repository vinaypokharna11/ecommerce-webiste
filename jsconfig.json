{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*", "./src/frontend/components/*"],
      "@/context/*": ["./src/context/*", "./src/frontend/context/*"],
      "@/utils/*": ["./src/utils/*", "./src/frontend/utils/*"],
      "@/assets/*": ["./src/assets/*", "./src/frontend/assets/*"],
      "@/backend/*": ["./src/backend/*", "./src/lib/*"],
      "@/database/*": ["./src/database/*", "./src/data/*"],
      "@/frontend/*": ["./src/frontend/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.js", "**/*.jsx"],
  "exclude": ["node_modules"]
}
