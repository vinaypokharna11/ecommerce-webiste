# ==============================================================================
# Nakoda Imitation / ShopEase - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Note: The system automatically falls back to local JSON persistence
# (src/data/db.json) if MONGODB_URI is not provided.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g., MongoDB Atlas or local mongod).
# If left unset, the application automatically uses atomic JSON storage.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nakoda_imitation?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT cookies.
# Required in production. Generate a strong random string (e.g., openssl rand -base64 32).
JWT_SECRET=your-super-secret-jwt-token-key-change-this-in-production

# ------------------------------------------------------------------------------
# 3. Administrator Credentials
# ------------------------------------------------------------------------------
# Default credentials for /admin dashboard access.
ADMIN_EMAIL=admin@shopease.com
ADMIN_PASSWORD=admin123
# Email address where admin order copies and inquiry notifications are delivered
ADMIN_NOTIFICATION_EMAIL=admin@nakodaimitation.com

# ------------------------------------------------------------------------------
# 4. WhatsApp Business Integration
# ------------------------------------------------------------------------------
# Primary WhatsApp numbers used for one-click checkout and customer inquiries.
# NEXT_PUBLIC_ prefixes make these variables accessible to browser components.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_WHATSAPP_DISPLAY=+91 98765 43210
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/919876543210
# Optional server-side fallback
WHATSAPP_NUMBER=919876543210

# ------------------------------------------------------------------------------
# 5. Cloudinary Media Storage (Optional)
# ------------------------------------------------------------------------------
# Used for persistent product image and banner uploads.
# If omitted, uploaded images fall back to Base64 data URLs.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. SMTP Email Notification Service (Nodemailer)
# ------------------------------------------------------------------------------
# Configure SMTP credentials to enable transactional emails:
# - Order confirmation to customer
# - Order notification to store admin
# - Inquiry / wholesale quotes notification
# - Test email verification (/api/email/test)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_SECURE=false
SMTP_FROM="Nakoda Imitation <orders@nakodaimitation.com>"

# ------------------------------------------------------------------------------
# 7. Environment Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
