# ─── DATABASE CONNECTION (SERVER-SIDE ONLY) ───────────────────────────────
# MongoDB connection string (e.g. MongoDB Atlas or local instance).
# NEVER commit real connection strings or database credentials to git.
# Example: mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/shopease?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_db_user:your_db_password@cluster0.example.mongodb.net/shopease?retryWrites=true&w=majority

# ─── JWT AUTHENTICATION SECRET (SERVER-SIDE ONLY) ───────────────────────────
# Secret key used for signing and verifying JSON Web Tokens for customers & admins.
# MUST be set to a strong, cryptographically secure random string (minimum 32 characters).
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters_long

# ─── ADMIN CREDENTIALS & NOTIFICATIONS (SERVER-SIDE ONLY) ───────────────────
# Master admin email and password.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_strong_admin_password_2026
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# ─── WHATSAPP INTEGRATION (CLIENT & SERVER) ─────────────────────────────────
# Set your WhatsApp business phone number with country code (numbers only, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=9879451341
# Direct WhatsApp Link (e.g. https://wa.me/919876543210 or custom short link)
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/9879451341
# Display phone format shown to users in UI
NEXT_PUBLIC_WHATSAPP_DISPLAY=+91 98794 51341

# ─── SMTP EMAIL CONFIGURATION (NODEMAILER / GMAIL) ───────────────────────────
# Server-side SMTP credentials for sending transactional order confirmations and inquiry alerts.
# For Gmail, generate an App Password from your Google Account Security settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_store_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="Store Name <orders@yourdomain.com>"
