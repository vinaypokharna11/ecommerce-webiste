# =============================================================================
# ShopEase / Nakoda Imitation - Environment Variables Template
# Copy this file to .env.local and populate with your own development secrets.
# NEVER commit real credentials or .env.local to version control!
# =============================================================================

# Application / Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Integration (Display and Click-to-Chat)
NEXT_PUBLIC_WHATSAPP_NUMBER=919879451341
NEXT_PUBLIC_WHATSAPP_DISPLAY=+91 98794 51341
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/919879451341

# Database Configuration (MongoDB Atlas or local MongoDB)
# Falls back to src/data/db.json in development if MONGODB_URI is not provided
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nakoda_imitation?retryWrites=true&w=majority

# Authentication & Cryptographic Signing
# Must be at least 32 characters in production
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production_min32chars

# Default Administrator Credentials (for initial database seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password_in_production
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# SMTP Email Service Configuration (Order & Inquiry Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_SECURE=false
SMTP_FROM="Nakoda Imitation <orders@nakodaimitation.com>"

# Cloudinary Media Storage (Optional for product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
